; em_sol.mdp - energy minimization of the solvated, neutralized system
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 5000
nstxout         = 20
nstenergy       = 1

cutoff-scheme   = Verlet
nstlist         = 10
pbc             = xyz
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
